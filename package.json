{
  "name": "secop-captcha",
  "version": "1.0.0",
  "description": "reCAPTCHA solving service for SECOP Colombia",
  "main": "src/server-ponytail.js",
  "scripts": {
    "start": "node src/server-ponytail.js",
    "dev": "node --watch src/server-ponytail.js",
    "solve": "node src/solver-ponytail.js solve",
    "solve-puppeteer": "node src/solver-ponytail.js solve-puppeteer",
