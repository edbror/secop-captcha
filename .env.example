# 2Captcha API key (primary solving farm)
RECAPTCHA_SERVICE_KEY=your_2captcha_api_key_here

# CapSolver API key (fallback solving farm)
CAPSOLVER_API_KEY=your_capsolver_api_key_here

# Which farm to use by default: "2captcha" or "capsolver"
FARM_SERVICE=2captcha

# Server port
PORT=3000

# Bind address (default: 127.0.0.1 for localhost-only)
HOST=127.0.0.1

# API key for endpoint authentication (X-API-Key header)
SECOP_CAPTCHA_API_KEY=your_endpoint_api_key_here

# Maximum concurrent requests (default: 10)
MAX_CONCURRENT=10

# Skip Google siteverify (set to "false" to enable)
VERIFY_WITH_GOOGLE=false

# Path to local Chrome binary (omit in Docker — uses bundled Chromium)
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
